[["Disculpe, ¿me puede ayudar?","Извините, вы можете мне помочь?",""],["¿Dónde está la estación de metro?","Где станция метро?",""],["¿Cuánto tiempo tarda el trámite?","Сколько займёт оформление?",""],["¿A qué hora abren mañana?","Во сколько вы завтра открываетесь?",""],["¿Hay una farmacia cerca?","Здесь есть аптека поблизости?",""],["Quisiera abrir una cuenta.","Я хотел бы открыть счёт.",""],["Me gustaría ver el departamento.","Я бы хотел посмотреть квартиру.",""],["¿Se puede pagar con tarjeta?","Можно оплатить картой?",""],["Acabo de llegar a la ciudad.","Я только что приехал в город.",""],["Perdón, estoy aprendiendo español.","Простите, я учу испанский.",""],["No entendí, ¿puede repetirlo?","Я не понял, можете повторить?",""],["¿Me lo puede escribir, por favor?","Можете мне это написать, пожалуйста?",""],["Es mi primera vez aquí, ¿qué me recomienda?","Я здесь первый раз, что посоветуете?",""],["¿El internet está incluido?","Интернет включён?",""],["Para la cita, ¿qué necesito traer?","Что мне принести на приём?",""],["Vengo por el departamento del anuncio.","Я по поводу квартиры из объявления.",""],["Tengo una cita a las diez.","У меня запись на десять.",""],["¿Me podría dar su número?","Не могли бы вы дать мне свой номер?",""],["Lo siento, no tengo cambio.","Извините, у меня нет сдачи.",""],["—Perdón. —No pasa nada.","— Простите. — Ничего страшного.",""],["Muchas gracias, ¡qué amable!","Большое спасибо, как любезно!",""],["¿Cómo llego al centro?","Как добраться до центра?",""],["¿Cuál es la diferencia entre estos planes?","В чём разница между этими тарифами?",""],["¡Aguas con el escalón!","Осторожно, ступенька!","Мексика (разг.). Нейтрально: ¡Cuidado!"],["¿Me regala un agua, por favor?","Дайте, пожалуйста, воды.","Колумбия: вежливая просьба, «regalar» здесь не значит «дарить»."],["¿Qué onda, güey? ¿Todo bien?","Как оно, чувак? Всё нормально?","Мексика, очень неформально."]]