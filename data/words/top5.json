[["¿Y tú?","А ты?",""],["¿Usted es el dueño?","Вы хозяин?",""],["Nosotros pagamos.","Мы заплатим.",""],["Ellos son mis vecinos.","Это мои соседи.",""],["¿Ustedes son de aquí?","Вы местные?","В Латинской Америке вместо vosotros."],["Es para mí.","Это для меня.",""],["Esto es para ti.","Это для тебя.",""],["¿Vienes conmigo?","Пойдёшь со мной?",""],["Quiero hablar contigo.","Я хочу с тобой поговорить.",""],["Les mando la dirección.","Я пришлю вам адрес.",""],["¿La llave? La tengo yo.","Ключ? Он у меня.",""],["No hay nadie en casa.","Дома никого нет.",""],["¿Alguien habla inglés?","Кто-нибудь говорит по-английски?",""],["No tengo ningún problema.","У меня нет никаких проблем.","Перед существительным м. р.: ningún."],["¿Quién es?","Кто там?",""],["¿Cuál prefieres?","Какой тебе больше нравится?",""],["¿Cuánto cuesta?","Сколько стоит?",""],["¿Cómo estás?","Как дела?",""],["¿Dónde está el baño?","Где туалет?",""],["¿Cuándo nos vemos?","Когда увидимся?",""],["¿Por qué no vienes?","Почему ты не придёшь?",""],["¿Qué es esto?","Что это?",""],["Aquella casa es de mi jefe.","Вон тот дом — моего начальника.",""],["¿Esta es tu bolsa?","Это твоя сумка?",""],["¿Es tuyo este celular?","Это твой телефон?",""],["Ese carro es mío.","Эта машина моя.",""],["¿Es suyo?","Это ваше?",""],["Camina hacia el parque.","Иди в сторону парка.",""],["Estoy en contra.","Я против.",""],["Durante la semana trabajo.","В течение недели я работаю.",""],["Según el mapa, es por aquí.","Судя по карте, это здесь.",""],["Antes de salir, cierra la puerta.","Перед уходом закрой дверь.",""],["Después de la cena vemos una película.","После ужина посмотрим фильм.",""],["Te espero delante del banco.","Жду тебя перед банком.",""],["El parque está detrás de la iglesia.","Парк за церковью.",""],["Las llaves están encima de la mesa.","Ключи на столе.",""],["El gato está debajo de la cama.","Кот под кроватью.",""],["La farmacia está enfrente del súper.","Аптека напротив супермаркета.",""],["Vivo al lado de la escuela.","Я 