[["¡Hola! ¿Cómo estás?","Привет! Как дела?",""],["Buenos días, señora.","Доброе утро, сеньора.",""],["Buenas tardes, ¿en qué le puedo ayudar?","Добрый день, чем могу вам помочь?",""],["Buenas noches, hasta mañana.","Спокойной ночи, до завтра.",""],["Adiós, que le vaya bien.","До свидания, всего вам доброго.",""],["Nos vemos, hasta luego.","Увидимся, пока.",""],["Un café, por favor.","Кофе, пожалуйста.",""],["Muchas gracias por todo.","Большое спасибо за всё.",""],["—Gracias. —De nada.","— Спасибо. — Не за что.",""],["Perdón, ¿me repite, por favor?","Простите, повторите, пожалуйста?",""],["Disculpe, ¿dónde está el baño?","Извините, где туалет?",""],["Sí, claro.","Да, конечно.",""],["No, gracias.","Нет, спасибо.",""],["¡Claro que sí!","Конечно!",""],["Está bien, nos vemos a las cinco.","Хорошо, увидимся в пять.","«Vale» говорят в Испании. В Мексике — «sale», в Аргентине — «dale»."],["Buenos días, don Carlos, ¿cómo está?","Доброе утро, дон Карлос, как вы?",""],["Me llamo Ana, mucho gusto.","Меня зовут Ана, очень приятно.",""],["Me llamo Iván, soy de Rusia.","Меня зовут Иван, я из России.",""],["Perdón, no entiendo. ¿Puede hablar más despacio?","Простите, я не понимаю. Можете говорить медленнее?",""],["Más despacio, por favor.","Помедленнее, пожалуйста.",""],["¿Qué significa «chamba»?","Что значит «chamba»?",""],["¿Cómo se dice esto en español?","Как это сказать по-испански?",""],["Necesito ayuda, por favor.","Мне нужна помощь, пожалуйста.",""],["Con permiso, ¿puedo pasar?","Разрешите, можно пройти?",""],["¡Buen provecho a todos!","Всем приятного аппетита!",""],["Ahorita vengo.","Сейчас приду.","В Мексике «ahorita» может значить и «прямо сейчас», и «как-нибудь потом»."],["¿Mande? No le entendí.","Простите? Я вас не расслышал.","Вежливое мексиканское «что?». В других странах: «¿Cómo?»"]]