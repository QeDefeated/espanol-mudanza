[["Es un buen barrio.","Это хороший район.","Перед существительным мужского рода: buen, mal."],["La recámara es pequeña.","Спальня маленькая.","В Мексике часто «chico» вместо «pequeño»."],["El edificio es viejo pero bonito.","Дом старый, но красивый.",""],["¡Qué bonita vista!","Какой красивый вид!",""],["La cocina está muy limpia.","Кухня очень чистая.",""],["¿Es seguro este barrio de noche?","Этот район безопасен ночью?",""],["La calle es muy ruidosa.","Улица очень шумная.",""],["El trámite no es difícil.","Оформление несложное.",""],["Estoy muy cansado del viaje.","Я очень устал с дороги.",""],["Estamos muy contentos aquí.","Нам здесь очень нравится.",""],["Mi hija está triste, extraña a sus amigos.","Дочь грустит, скучает по друзьям.",""],["Estoy preocupado por la visa.","Я переживаю из-за визы.",""],["¿Estás enojado conmigo?","Ты на меня сердишься?","В Испании: enfadado."],["La película es aburrida.","Фильм скучный.","Estar aburrido — скучать; ser aburrido — быть скучным."],["Tengo frío, ¿cierras la ventana?","Мне холодно, закроешь окно?",""],["Hoy hace mucho calor.","Сегодня очень жарко.",""],["En verano llueve todas las tardes.","Летом каждый день после обеда идёт дождь.",""],["Me encanta el clima de aquí.","Мне очень нравится здешний климат.",""],["El internet es muy lento.","Интернет очень медленный.",""],["Hablo poco español.","Я немного говорю по-испански.",""],["Nunca manejo de noche.","Я никогда не вожу ночью.",""],["¿Me lo explica otra vez?","Объясните ещё раз?",""],["Ya llegué.","Я уже приехал.",""],["Todavía no tengo cuenta bancaria.","У меня ещё нет банковского счёта.",""],["¡Qué chido tu departamento!","Какая классная у тебя квартира!","Мексика. Колумбия: bacano, chévere. Аргентина: copado, re lindo."],["¿Te dieron la visa? ¡Qué padre!","Тебе дали визу? Здорово!","Мексика."],["La fiesta estuvo chévere.","Вечеринка была классная.","Колумбия, Венесуэла, Перу."]]