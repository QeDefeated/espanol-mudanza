[["Hola, ¿qué tal?","Привет, как дела?",""],["¿Cómo te va en el trabajo nuevo?","Как дела на новой работе?",""],["¿Qué hay de nuevo?","Что нового?",""],["—¡Buen fin de semana! —Igualmente.","— Хороших выходных! — И вам.",""],["Encantado de conocerte.","Очень рад знакомству.",""],["¡Bienvenido a la familia!","Добро пожаловать в семью!",""],["¡Que te vaya bien en la entrevista!","Удачи на собеседовании!",""],["Nos vemos, ¡cuídate!","Увидимся, береги себя!",""],["¡Nos vemos el lunes!","Увидимся в понедельник!",""],["¡Buen fin a todos!","Всем хороших выходных!",""],["¡Felicidades por tu cumpleaños!","Поздравляю с днём рождения!",""],["—¡Provecho! —Gracias.","— Приятного аппетита! — Спасибо.","В Мексике говорят даже незнакомым людям в кафе."],["¡Ánimo, tú puedes!","Держись, у тебя получится!",""],["¡Échale ganas al español!","Налегай на испанский!","Мексика."],["¿Ya tienes trabajo? ¡Qué bien!","У тебя уже есть работа? Здорово!",""],["¡Qué pena, no te vi!","Как неловко, я тебя не заметил!","В Мексике и Колумбии «pena» — неловкость, стыд."],["¿No puedes venir? ¡Qué lástima!","Не можешь прийти? Как жаль!",""],["¿Cuesta eso? ¡No manches!","Столько стоит? Да ладно!","Мексика, разговорное."],["¡Órale, qué rápido!","Ого, как быстро!","Мексика, очень многозначное."],["¡Ándale, vamos!","Давай, пошли!","Мексика."],["¡Híjole, se me olvidó!","Ой, я забыл!","Мексика."],["Te ayudó con la mudanza, ¡qué buena onda!","Он помог тебе с переездом — какой молодец!","Мексика, Аргентина."],["Mi jefe es muy buena onda.","Мой начальник — классный мужик.",""],["Se fue el camión, ¡ni modo!","Автобус ушёл, ничего не поделаешь.",""],["¡Ya está, ya terminé!","Готово, я закончил!",""],["—¿Nos vemos a las cinco? —¡Va!","— Встречаемся в пять? — Идёт!","Мексика."],["—¿Mañana? —¡Sale!","— Завтра? — Договорились!","Мексика."],["—¿Vamos? —¡Dale!","— Пойдём? — Давай!","Аргентина, Колумбия, Чили."],["—¿Te molesta? —¡Para nada!","— Тебе мешает? — Вовсе нет!",""],["¿Manejar aquí? ¡Ni loco!","Водить здесь? Ни за что!",""],["¡Ojo con la cartera en el metro!","Следи за кошельком в метро!",""],["¡Cuidado, viene un carro!","Осторожно, машина!",""],["¡Auxilio, llamen a una ambulancia!","Помогите, вызовите скорую!",""],["¡Ya, ya entendí!","Всё-всё, я понял!",""],["No te preocupes, yo pago.","Не волнуйся, я заплачу.",""],["—Gracias. —No hay de qué.","— Спасибо. — Не за что.",""],["—Gracias. —Con gusto.","— Спасибо. — Пожалуйста.","Колумбия, Мексика — вместо «de nada»."],["A sus órdenes, ¿qué necesita?","К вашим услугам, что нужно?","Мексика; «a la orden» — Колумбия."],["¿Me permite su identificación?","Позвольте ваше удостоверение.",""],["¿Me haces un favor? Cuida mis cosas.","Сделай одолжение — присмотри за вещами.",""],["¿Me echas la mano con la mudanza?","Поможешь мне с переездом?","Мексика."],["¿Me das chance de pasar?","Дашь пройти?","Мексика: «chance» — возможность, разрешение."],["¿Tacos? ¡Me late!","Тако? Я за!","Мексика."],["Qué flojera ir al súper.","Как же лень идти в магазин.","Мексика."],["Me da pena hablar en español.","Мне неловко говорить по-испански.","Мексика."],["Me da miedo manejar aquí.","Мне страшно водить здесь.",""],["Me da risa tu acento.","Мне смешно от твоего акцента.",""],["Tu vecina me cae muy bien.","Твоя соседка мне очень нравится.",""],["Ese tipo me cae mal.","Этот тип мне неприятен.",""],["¡Ah, ya me cayó el veinte!","А, до меня дошло!","Мексика."],["Se me olvidó la cartera.","Я забыл кошелёк.",""],["Perdón, se me hizo tarde.","Простите, я задержался.",""],["Se me acabó la pila, te escribo luego.","У меня сел телефон, напишу позже.","Мексика: «pila» — батарейка, заряд."],["¿En serio? ¡No lo puedo creer!","Серьёзно? Не могу поверить!",""],["¿Neta te vas a mudar?","Ты правда переезжаешь?","Мексика."],["¿A poco ya hablas español?","Неужели ты уже говоришь по-испански?","Мексика."],["¿Cuál es el plan para hoy?","Какие планы на сегодня?",""],["¿Qué te parece si vamos a la playa?","Как насчёт того, чтобы поехать на пляж?",""],["¿Por qué no pedimos pizza?","Почему бы не заказать пиццу?",""],["A ver, déjame pensar.","Так, дай подумать.",""],["—¿Es caro? —Depende.","— Дорого? — Смотря как.",""],["La verdad, no me gusta.","Честно говоря, мне не нравится.",""],["Fíjate que me dieron la visa.","Представляешь, мне дали визу.",""],["Es que no tengo tiempo.","Дело в том, что у меня нет времени.",""],["Lo que pasa es que perdí el boleto.","Дело в том, что я потерял билет.",""],["Voy de volada a la tienda.","Я мигом в магазин.","Мексика."],["En un ratito te atiendo.","Через минутку я вами займусь.",""],["¡Quiubo! ¿Cómo estás?","Привет! Как ты?","Мексика, Колумбия (от «¿qué hubo?»)."],["¿Qué más, parce?","Как дела, бро?","Колумбия."],["Che, ¿vamos a tomar un café?","Слушай, пойдём выпьем кофе?","Аргентина, Уругвай."],["Tengo un montón de trabajo.","У меня куча работы.",""],["Había un chorro de gente.","Было очень много народу.","Мексика."],["Un poquito más, por favor.","Ещё чуть-чуть, пожалуйста.",""],["Poco a poco aprendo.","Понемногу учусь.",""],["Hazlo con calma.","Делай не спеша.",""],["Sin problema, yo te ayudo.","Без проблем, я помогу.",""],["¿Todo bien con el departamento?","С квартирой всё хорошо?",""],["Todo bien, gracias.","Всё хорошо, спасибо.",""],["—¿Dónde está? —Ni idea.","— Где это? — Понятия не имею.",""],["Ya veremos qué pasa.","Посмотрим, что будет.",""],["¡Ya voy, ya voy!","Иду, иду!",""],["—¿Cómo vas con el español? —Ahí vamos.","— Как успехи в испанском? — Потихоньку.",""],["¿Cuánto le debo, joven?","Сколько я вам должен?",""],["Disculpe, ¿me cobra?","Извините, посчитаете меня?","Мексика: просьба принять оплату."],["¿Tiene cambio de doscientos?","У вас будет сдача с двухсот?",""],["Sería todo, gracias.","Это всё, спасибо.",""],["—¿Algo más? —No, gracias.","— Что-нибудь ещё? — Нет, спасибо.",""],["Nada más el café, gracias.","Только кофе, спасибо.",""],["—Gracias. —Para servirle.","— Спасибо. — Рад помочь.",""],["Disculpe la molestia, ¿tiene un minuto?","Извините за беспокойство, у вас есть минутка?",""],["Perdón por la tardanza, había tráfico.","Простите за опоздание, были пробки.",""],["¿Es festivo? Con razón no hay nadie.","Сегодня праздник? Понятно, почему никого нет.",""],["Tranquilo, no pasa nada.","Спокойно, ничего страшного.",""],["¿Qué onda? ¿Todo bien?","Как дела? Всё нормально?","Мексика."],["Llegar sin reservar fue mal plan.","Прийти без брони было плохой идеей.",""],["El concierto estuvo de pelos.","Концерт был классный.","Мексика, разговорное."],["Me vale lo que digan.","Мне плевать, что скажут.","Мексика, грубовато."],["Ya merito llegamos.","Мы уже почти приехали.","Мексика."],["¡Ahí nos vidrios!","Ну, увидимся!","Мексика, шутливая игра слов от «ahí nos vemos»."],["¡Salucita a todos!","За здоровье всех!","Мексика, уменьшительное от «salud»."]]